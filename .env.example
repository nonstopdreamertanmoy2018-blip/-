# Local development only. For production, use a managed secret store and strong unique values.
# Never expose DATABASE_URL, JWT_SECRET, or admin passwords to frontend (VITE_*) variables.
APP_NAME="Next Generation Company Limited ERP"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./erp_dev.db"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRE_MINUTES="60"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="ChangeThis-Immediately-123!"
FASTAPI_PORT="8000"

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
